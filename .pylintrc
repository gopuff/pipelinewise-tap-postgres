[MAIN]
ignore=CVS

[MESSAGES CONTROL]
disable=wrong-import-order,
        broad-exception-caught,
        broad-exception-raised,
        missing-module-docstring,
        duplicate-code,
        # Added in pylint 3.3; the flagged signatures predate it and are called positionally.
        too-many-positional-arguments

[FORMAT]
max-line-length=120
ignore-long-lines=^\s*(# )?<?https?://\S+>?$
max-module-lines=1000

[TYPECHECK]
ignore-mixin-members=yes

[SIMILARITIES]
ignore-comments=yes
ignore-docstrings=yes
ignore-imports=no

[BASIC]
good-names=i,j,k,ex,Run,_

[REFACTORING]
max-nested-blocks=5

[VARIABLES]
ignored-argument-names=_.*

[DESIGN]
max-args=5
max-locals=15
max-returns=6
max-branches=12
max-statements=50
max-parents=7
max-attributes=7
max-public-methods=20
max-bool-expr=5
